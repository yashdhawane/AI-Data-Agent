// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  normalizedName String @unique
  plan      OrganizationPlan @default(SMALL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  dataSources DataSource[]
  relationships DataRelationship[]
  businessContext BusinessContext?
}

enum OrganizationPlan {
  SMALL
  MID_SCALE
  ENTERPRISE
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  role           UserRole @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  MEMBER
}

enum DataSourceType {
  postgresql
  mongodb
}


model DataSource {
  id             String       @id @default(cuid())
  name           String
  type           DataSourceType
  connectionUrl  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceRelationships DataRelationship[] @relation("SourceRelationships")
  targetRelationships DataRelationship[] @relation("TargetRelationships")
}

enum RelationshipStatus {
  DISCOVERED
  ACCEPTED
  REJECTED
}

model DataRelationship {
  id                  String             @id @default(cuid())
  organizationId      String
  sourceDataSourceId  String
  sourceEntity        String
  sourceField         String
  targetDataSourceId  String
  targetEntity        String
  targetField         String
  confidence          Float
  rationale           String
  status              RelationshipStatus @default(DISCOVERED)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceDataSource DataSource @relation("SourceRelationships", fields: [sourceDataSourceId], references: [id], onDelete: Cascade)
  targetDataSource DataSource @relation("TargetRelationships", fields: [targetDataSourceId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model BusinessContext {
  id             String   @id @default(cuid())
  organizationId String   @unique
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}